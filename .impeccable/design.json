      "css": ".ds-search{position:relative;display:flex;align-items:center;width:100%;max-width:376px}.ds-search-icon{position:absolute;left:13px;width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.8;color:var(--muted, #59636a);pointer-events:none}.ds-search-input{width:100%;height:44px;padding:0 64px 0 42px;border:1px solid #aeb5b5;border-radius:9px;background:var(--paper-light, #fbfaf7);color:var(--ink, #17242b);font:14px sans-serif}.ds-search-input:focus-visible{outline:3px solid var(--focus, #135b7a);outline-offset:2px;}.ds-keycap{position:absolute;right:10px;padding:3px 5px;border:1px solid #d4d5d0;border-radius:5px;color:#596168;font:11px monospace}"

      "css": ".ds-site-row{display:grid;grid-template-columns:27px minmax(0,1fr) 68px auto;gap:8px;align-items:center;min-height:71px;border-top:1px solid var(--line, #c8c9c4);border-bottom:1px solid var(--line, #c8c9c4);background:var(--paper, #f2f0ea);color:var(--ink, #17242b)}.ds-site-row:hover{background:rgba(255,255,255,.48)}.ds-site-number,.ds-site-copy small{color:var(--muted, #59636a);font:11px monospace}.ds-site-copy{min-width:0}.ds-site-copy strong,.ds-site-copy small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-site-copy strong{font:750 14px sans-serif}.ds-site-method{color:var(--muted, #59636a);font:650 11px sans-serif;text-align:center;white-space:nowrap}.ds-site-action{height:34px;min-width:66px;padding:0 10px;border:1px solid var(--accent, #e76f41);border-radius:7px;background:var(--accent, #e76f41);color:white;font:750 13px sans-serif}.ds-site-action:hover{background:var(--accent-hover, #c7532c)}.ds-site-action:focus-visible{outline:3px solid var(--focus, #135b7a);outline-offset:2px;}"
